# Public Vite variables only — these are embedded in the browser bundle.
# Copy to .env locally. Never commit real values.
# Never put SUPABASE_SERVICE_ROLE_KEY (or any non-VITE_* secret) in a VITE_ variable.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
VITE_RAZORPAY_KEY=
